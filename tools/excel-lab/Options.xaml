<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Excel Lab · Messen und vergleichen" Width="860" Height="820"
        MinWidth="740" MinHeight="580" WindowStartupLocation="CenterScreen"
        Background="#F4F6FA" FontFamily="Segoe UI" FontSize="13">
  <Window.Resources>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,3,8,5"/><Setter Property="BorderBrush" Value="#CFD7E3"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Margin" Value="0,3,8,5"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,5,12,5"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,3,7,5"/><Setter Property="Background" Value="#E7EDF5"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#1C3652"/><Setter Property="Margin" Value="0,12,0,7"/></Style>
    <Style TargetType="GroupBox"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DEE5EF"/></Style>
  </Window.Resources>
  <Grid Margin="24,18,20,16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="Excel Lab" FontSize="28" FontWeight="SemiBold" Foreground="#143552"/>
      <TextBlock Text="Ein Makro-Host. Schnelle Metadaten. Optionale Detail- und Bildprüfungen." Margin="0,4,0,12" Foreground="#56677A" TextWrapping="Wrap"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,10,0">
        <TextBlock Text="Eingabe" Style="{StaticResource Section}"/>
        <ComboBox Name="ModeBox" SelectedIndex="0">
          <ComboBoxItem Tag="shrink">Shrink ausführen und Original / Shrunk vergleichen</ComboBoxItem>
          <ComboBoxItem Tag="compare">Zwei vorhandene XLSX-Dateien vergleichen</ComboBoxItem>
          <ComboBoxItem Tag="inspect">XLSX-Datei oder Ordner untersuchen (ohne Shrink)</ComboBoxItem>
        </ComboBox>
        <TextBlock Text="Originaldatei oder Ordner (Ordner nicht rekursiv)"/>
        <DockPanel><Button Name="BrowseFolder" DockPanel.Dock="Right" Content="Ordner…"/><Button Name="BrowseInput" DockPanel.Dock="Right" Content="Datei…"/><TextBox Name="InputBox"/></DockPanel>
        <TextBlock Text="Zweite Datei – nur beim Vergleich vorhandener Dateien"/>
        <DockPanel><Button Name="BrowseOther" DockPanel.Dock="Right" Content="Datei…"/><TextBox Name="OtherBox"/></DockPanel>
        <TextBlock Text="Rust-Shrink-Profil"/>
        <ComboBox Name="ProfileBox"/>
        <GroupBox Header="Messungen">
          <StackPanel>
            <TextBlock Text="UsedRange, Bereichshöhe und -breite werden immer schnell erfasst." TextWrapping="Wrap" FontWeight="SemiBold"/>
            <CheckBox Name="ShapesCheck" Content="UsedRange um sichtbare Shape-Geometrie erweitern" IsChecked="True"/>
            <TextBlock Text="Zeilenhöhen: zusätzliche Detailprüfung" Margin="0,6,0,0"/>
            <ComboBox Name="RowsBox" SelectedIndex="0">
              <ComboBoxItem Tag="none">Kein Zeilenscan – nur schnelle Bereichshöhen</ComboBoxItem>
              <ComboBoxItem Tag="used-union">Jede Zeile bis zum größeren UsedRange-Ende</ComboBoxItem>
              <ComboBoxItem Tag="all">Jede Worksheet-Zeile, auch außerhalb des UsedRange (langsam)</ComboBoxItem>
            </ComboBox>
            <CheckBox Name="HashCheck" Content="SHA-256 pro Blatt aus Zellkoordinaten und typisierten Value2-Werten"/>
            <CheckBox Name="ValuesCheck" Content="Wertevergleich direkt in VBA (blockweise; genaue Differenzanzahl)"/>
          </StackPanel>
        </GroupBox>
        <GroupBox Header="Bilder und visuelle Vergleiche">
          <StackPanel>
            <CheckBox Name="ShotsCheck" Content="Bereiche aufnehmen (ein VBA-Batch; gekachelte Aufnahme)"/>
            <ComboBox Name="StorageBox" SelectedIndex="0">
              <ComboBoxItem Tag="png">PNG direkt in VBA / GDI+</ComboBoxItem>
              <ComboBoxItem Tag="bmp">BMP (RGB24) → nach dem Batch parallel mit Rust zu PNG</ComboBoxItem>
              <ComboBoxItem Tag="both">Beide Wege messen (unabhängige Aufnahmen)</ComboBoxItem>
            </ComboBox>
            <CheckBox Name="MatrixCheck" Content="CopyPicture-Matrix: Screen / Printer × Bitmap / Picture (EMF)"/>
            <CheckBox Name="TransparentCheck" Content="Zusätzlicher EMF-auf-transparenter-PNG-Leinwand-Versuch"/>
            <CheckBox Name="VbaVisualCheck" Content="Bilder direkt in VBA vergleichen (eigene Speicherpuffer; Experiment)"/>
            <CheckBox Name="RustVisualCheck" Content="Bilder anschließend mit Rust vergleichen und Differenz-PNGs schreiben"/>
            <TextBlock Text="Transparenz hängt vom tatsächlichen EMF-Inhalt ab. Weiß wird nicht künstlich transparent gemacht. Shape-Geometrie ist kein Nachweis aller gezeichneten Pixel." TextWrapping="Wrap" Foreground="#6C5B35" Margin="0,7,0,0"/>
          </StackPanel>
        </GroupBox>
        <TextBlock Text="Optionaler Aufnahme- / Overflow-Plan (JSON)" Style="{StaticResource Section}"/>
        <DockPanel><Button Name="BrowsePlan" DockPanel.Dock="Right" Content="Plan…"/><TextBox Name="PlanBox"/></DockPanel>
        <TextBlock Text="Planbereiche werden für alle Blätter auf einmal übergeben. Text-Overflow-Experimente sind nur mit explizitem Plan aktiv." TextWrapping="Wrap" Foreground="#56677A"/>
        <Expander Header="Grenzen und Leistung" Margin="0,14,0,8">
          <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
            <TextBlock Text="Zellen pro Value2-Block" VerticalAlignment="Center"/><TextBox Name="BlockBox" Grid.Column="1" Text="65536"/>
            <TextBlock Grid.Column="2" Text="Max. Zellen je Blattprüfung" VerticalAlignment="Center"/><TextBox Name="MaxCellsBox" Grid.Column="3" Text="20000000"/>
            <TextBlock Grid.Row="1" Text="Kachelgröße (Punkte)" VerticalAlignment="Center"/><TextBox Name="TileBox" Grid.Row="1" Grid.Column="1" Text="1200"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Max. Kacheln je Variante" VerticalAlignment="Center"/><TextBox Name="MaxTilesBox" Grid.Row="1" Grid.Column="3" Text="1024"/>
            <TextBlock Grid.Row="2" Text="Rust-Bildworker" VerticalAlignment="Center"/><TextBox Name="WorkersBox" Grid.Row="2" Grid.Column="1" Text="4"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Max. Differenzdetails" VerticalAlignment="Center"/><TextBox Name="MaxDiffBox" Grid.Row="2" Grid.Column="3" Text="1000"/>
            <TextBlock Grid.Row="3" Text="Stillstands-Timeout (s)" VerticalAlignment="Center"/><TextBox Name="StallBox" Grid.Row="3" Grid.Column="1" Text="1800"/>
          </Grid>
        </Expander>
        <CheckBox Name="DiffCheck" Content="Original- und Shrunk-JSON in VS Code gegenüberstellen" IsChecked="True"/>
      </StackPanel>
    </ScrollViewer>
    <DockPanel Grid.Row="2" Margin="0,14,0,0">
      <Button Name="BuildButton" Content="Makro-Host bauen / aktualisieren" DockPanel.Dock="Left"/>
      <Button Name="RunButton" Content="Starten" Background="#17669E" Foreground="White" FontWeight="SemiBold" DockPanel.Dock="Right" IsDefault="True"/>
      <Button Name="CancelButton" Content="Abbrechen" DockPanel.Dock="Right" IsCancel="True"/>
    </DockPanel>
  </Grid>
</Window>
