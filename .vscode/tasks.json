{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Visual validation: Run comparison suite",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "script=\"$(wslpath -w \"$1/docs/visual-validation/experiments/suite.ps1\")\"; powershell.exe -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File \"$script\"",
        "vv-comparison-suite",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "group": "experiments"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-STA",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\docs\\visual-validation\\experiments\\suite.ps1"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      }
    },
    {
      "label": "Visual validation: Repair latest suite reports (no Excel)",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "script=\"$(wslpath -w \"$1/docs/visual-validation/experiments/repair-suite.ps1\")\"; powershell.exe -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File \"$script\"",
        "vv-repair-suite",
        "${workspaceFolder}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-STA",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/docs/visual-validation/experiments/repair-suite.ps1"
        ]
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "cargo build",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\invoke-wsl-repo.ps1",
          "-RepoRoot",
          "${workspaceFolder}",
          "-Executable",
          "cargo",
          "-ArgumentsJson",
          "[\"build\",\"-p\",\"excel-shrink-cli\",\"--bin\",\"excel-shrink-cli\"]"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      }
    },
    {
      "label": "cargo build release",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\invoke-wsl-repo.ps1",
          "-RepoRoot",
          "${workspaceFolder}",
          "-Executable",
          "cargo",
          "-ArgumentsJson",
          "[\"build\",\"--release\",\"-p\",\"excel-shrink-cli\",\"--bin\",\"excel-shrink-cli\"]"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      }
    },
    {
      "label": "Release smoke test (pick case, no debugger)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli",
        "--",
        "regression",
        "smoke",
        "--case-id",
        "${input:corpusRegressionCaseId}",
        "--console-log-level",
        "info"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\invoke-wsl-repo.ps1",
          "-RepoRoot",
          "${workspaceFolder}",
          "-Executable",
          "cargo",
          "-ArgumentsJson",
          "[\"run\",\"--release\",\"-p\",\"excel-shrink-cli\",\"--bin\",\"excel-shrink-cli\",\"--\",\"regression\",\"smoke\",\"--case-id\",\"${input:corpusRegressionCaseId}\",\"--console-log-level\",\"info\"]"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Release smoke visual profile matrix (pick case, no debugger)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli",
        "--",
        "regression",
        "smoke",
        "--case-id",
        "${input:corpusRegressionCaseId}",
        "--all-visual-profile-checks",
        "--console-log-level",
        "info"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\invoke-wsl-repo.ps1",
          "-RepoRoot",
          "${workspaceFolder}",
          "-Executable",
          "cargo",
          "-ArgumentsJson",
          "[\"run\",\"--release\",\"-p\",\"excel-shrink-cli\",\"--bin\",\"excel-shrink-cli\",\"--\",\"regression\",\"smoke\",\"--case-id\",\"${input:corpusRegressionCaseId}\",\"--all-visual-profile-checks\",\"--console-log-level\",\"info\"]"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Profile smoke test (pick case, Perfetto, no debugger)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--profile",
        "profiling",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli",
        "--",
        "regression",
        "smoke",
        "--case-id",
        "${input:corpusRegressionCaseId}",
        "--console-log-level",
        "info",
        "--trace-file",
        "${workspaceFolder}/.tmp/profiles/smoke-{timestamp}.json"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\invoke-wsl-repo.ps1",
          "-RepoRoot",
          "${workspaceFolder}",
          "-Executable",
          "cargo",
          "-ArgumentsJson",
          "[\"run\",\"--profile\",\"profiling\",\"-p\",\"excel-shrink-cli\",\"--bin\",\"excel-shrink-cli\",\"--\",\"regression\",\"smoke\",\"--case-id\",\"${input:corpusRegressionCaseId}\",\"--console-log-level\",\"info\",\"--trace-file\",\"${workspaceFolder}/.tmp/profiles/smoke-{timestamp}.json\"]"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Excel Shrink: Clear validation caches",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/clean_generated.py",
        "--cache-only"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Excel Shrink: Reset local generated state",
      "type": "shell",
      "command": "python3",
      "args": [
        "tools/clean_generated.py",
        "--fresh"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Excel tools: Shrink only",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/excel-height-check/run.py",
        "--profile",
        "${input:heightShrinkProfile}",
        "--only-file",
        "${input:heightCorpusFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel tools: Default heights",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/excel-height-check/run.py",
        "--profile",
        "default",
        "--height",
        "--only-file",
        "${input:heightCorpusFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel tools: Maximum Cleaning heights",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/excel-height-check/run.py",
        "--profile",
        "maximum-cleaning",
        "--height",
        "--only-file",
        "${input:heightCorpusFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel tools: All profile heights",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/excel-height-check/run.py",
        "--profile",
        "all",
        "--height",
        "--only-file",
        "${input:heightCorpusFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel tools: Default heights after Excel save",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/tools/excel-height-check/run.py",
        "--profile",
        "default",
        "--height",
        "--resave-originals",
        "--only-file",
        "${input:heightCorpusFile}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel tools: Select file or folder - Shrink - JSON diff",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/excel-lab/run.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/excel-lab/run_wsl.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel lab: Build macro host",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/excel-lab/run.ps1",
        "-Action",
        "build"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/excel-lab/run_wsl.sh",
          "build"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel lab: Excel and clipboard self-test",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/excel-lab/run.ps1",
        "-Action",
        "self-test"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/excel-lab/run_wsl.sh",
          "self-test"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel lab: Pure PowerShell tests",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/excel-lab/tests/pure.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/excel-lab/tests/pure_wsl.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel lab: Legacy exhaustive row JSON diff",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/excel-height-check/json_diff.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/excel-height-check/json_diff_wsl.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Excel lab: Rust image tests",
      "type": "process",
      "command": "cargo",
      "args": [
        "test",
        "--manifest-path",
        "${workspaceFolder}/tools/excel-lab/native/Cargo.toml",
        "--target-dir",
        "${workspaceFolder}/.tmp/excel-lab-rust-target"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\tools\\invoke-wsl-repo.ps1",
          "-RepoRoot",
          "${workspaceFolder}",
          "-Executable",
          "cargo",
          "-ArgumentsJson",
          "[\"test\",\"--manifest-path\",\"${workspaceFolder}/tools/excel-lab/native/Cargo.toml\",\"--target-dir\",\"${workspaceFolder}/.tmp/excel-lab-rust-target\"]"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Experiment: visual validation",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "script=\"$(wslpath -w '${workspaceFolder}/docs/visual-validation/experiments/run.ps1')\"; corpus=\"$(wslpath -w '${workspaceFolder}/corpus-local')\"; powershell.exe -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File \"$script\" -CorpusRoot \"$corpus\" -InterfaceMode '${input:visualValidationInterfaceMode}'"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true,
        "group": "experiments"
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-STA",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\docs\\visual-validation\\experiments\\run.ps1",
          "-CorpusRoot",
          "${workspaceFolder}\\corpus-local",
          "-InterfaceMode",
          "${input:visualValidationInterfaceMode}"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      }
    },
    {
      "label": "Experiment: PNG diagnostics (choose test)",
      "type": "process",
      "command": "bash",
      "args": [
        "-lc",
        "script=\"$(wslpath -w \"$1/docs/visual-validation/experiments/run.ps1\")\"; corpus=\"$(wslpath -w \"$1/corpus-local\")\"; powershell.exe -NoLogo -NoProfile -STA -ExecutionPolicy Bypass -File \"$script\" -CorpusRoot \"$corpus\" -Experiment \"$2\" -NonInteractive",
        "vv-diagnostics",
        "${workspaceFolder}",
        "${input:pngDiagnosticExperiment}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "clear": true
      },
      "runOptions": {
        "instanceLimit": 1
      },
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-STA",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\docs\\visual-validation\\experiments\\run.ps1",
          "-CorpusRoot",
          "${workspaceFolder}\\corpus-local",
          "-Experiment",
          "${input:pngDiagnosticExperiment}",
          "-NonInteractive"
        ],
        "options": {
          "cwd": "${env:TEMP}"
        }
      }
    }
  ],
  "inputs": [
    {
      "id": "visualValidationInterfaceMode",
      "type": "pickString",
      "description": "Visual validation interface",
      "options": [
        "cli",
        "gui"
      ],
      "default": "cli"
    },
    {
      "id": "corpusRegressionCaseId",
      "type": "pickString",
      "description": "Corpus regression smoke case",
      "options": [
        "overall-reduction",
        "empty-cells",
        "empty-rows",
        "trailing-layout-rows",
        "empty-row-attributes",
        "column-range-merge",
        "unreferenced-whitespace",
        "unreferenced-hidden-content",
        "hidden-empty-rows"
      ],
      "default": "empty-cells"
    },
    {
      "id": "heightCorpusFile",
      "type": "promptString",
      "description": "Exact XLSX filename in local corpus, or * for all files",
      "default": "*"
    },
    {
      "id": "heightShrinkProfile",
      "type": "pickString",
      "description": "Shrink profile",
      "options": [
        "default",
        "maximum-cleaning"
      ],
      "default": "default"
    },
    {
      "id": "pngDiagnosticExperiment",
      "type": "pickString",
      "description": "PNG diagnostic experiment",
      "options": [
        "range-image-height-limit",
        "range-image-calibration"
      ],
      "default": "range-image-height-limit"
    }
  ]
}
