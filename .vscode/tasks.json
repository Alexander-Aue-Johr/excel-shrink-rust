{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SheetScope: Build Windows release",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bins"
      ],
      "linux": {
        "args": [
          "build",
          "--release",
          "--target",
          "x86_64-pc-windows-gnu",
          "-p",
          "excel-shrink-cli",
          "--bins"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH};${userHome}/.cargo/bin"
          }
        }
      },
      "problemMatcher": [
        "$rustc"
      ],
      "group": "build"
    },
    {
      "label": "SheetScope: Start Observatory",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\start-sheet-scope.ps1",
        "-SourceRepo",
        "${workspaceFolder}",
        "-BinaryPath",
        "${workspaceFolder}\\target\\release\\sheet-scope.exe"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/start-sheet-scope-wsl.sh"
        ]
      },
      "dependsOn": [
        "SheetScope: Build Windows release"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "SheetScope: Test Destatis (prefilled)",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\start-sheet-scope.ps1",
        "-SourceRepo",
        "${workspaceFolder}",
        "-BinaryPath",
        "${workspaceFolder}\\target\\release\\sheet-scope.exe",
        "-Destatis"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/start-sheet-scope-wsl.sh",
          "-Destatis"
        ]
      },
      "dependsOn": [
        "SheetScope: Build Windows release"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "showReuseMessage": false
      }
    },
    {
      "label": "cargo build",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH};${userHome}/.cargo/bin"
          }
        }
      }
    },
    {
      "label": "cargo build release",
      "type": "process",
      "command": "cargo",
      "args": [
        "build",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH};${userHome}/.cargo/bin"
          }
        }
      }
    },
    {
      "label": "Release smoke test (pick case, no debugger)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli",
        "--",
        "regression",
        "smoke",
        "--case-id",
        "${input:corpusRegressionCaseId}",
        "--console-log-level",
        "info"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH};${userHome}/.cargo/bin"
          }
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Release smoke visual diagnosis (pick case, no debugger)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli",
        "--",
        "regression",
        "smoke",
        "--case-id",
        "${input:corpusRegressionCaseId}",
        "--diagnose-visual-changes",
        "--console-log-level",
        "info"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH};${userHome}/.cargo/bin"
          }
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Excel Shrink: Configure corpus run",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-STA",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\start-corpus.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH};${userHome}/.cargo/bin"
        }
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/tools/start-corpus-wsl.sh"
        ],
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH}:${userHome}/.cargo/bin"
          }
        }
      },
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false,
        "focus": false,
        "showReuseMessage": false
      },
      "runOptions": {
        "reevaluateOnRerun": true
      }
    },
    {
      "label": "Profile smoke test (pick case, Perfetto, no debugger)",
      "type": "process",
      "command": "cargo",
      "args": [
        "run",
        "--profile",
        "profiling",
        "-p",
        "excel-shrink-cli",
        "--bin",
        "excel-shrink-cli",
        "--",
        "regression",
        "smoke",
        "--case-id",
        "${input:corpusRegressionCaseId}",
        "--console-log-level",
        "info",
        "--trace-file",
        "${workspaceFolder}/.tmp/profiles/smoke-{timestamp}.json"
      ],
      "problemMatcher": [
        "$rustc"
      ],
      "group": "test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:PATH}:${userHome}/.cargo/bin"
        }
      },
      "windows": {
        "options": {
          "cwd": "${workspaceFolder}",
          "env": {
            "PATH": "${env:PATH};${userHome}/.cargo/bin"
          }
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "Excel Shrink: Performance Demo",
      "type": "process",
      "command": "${env:SystemRoot}\\System32\\WindowsPowerShell\\v1.0\\powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tools\\demo-kernhaushalte.ps1",
        "-ExcelShrinkExe",
        "${workspaceFolder}\\target\\release\\excel-shrink-cli.exe"
      ],
      "dependsOn": [
        "cargo build release"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "focus": false,
        "showReuseMessage": false
      },
      "runOptions": {
        "reevaluateOnRerun": true
      }
    }
  ],
  "inputs": [
    {
      "id": "corpusRegressionCaseId",
      "type": "pickString",
      "description": "Corpus regression smoke case",
      "options": [
        "overall-reduction",
        "empty-cells",
        "empty-rows",
        "trailing-layout-rows",
        "empty-row-attributes",
        "column-range-merge",
        "unreferenced-whitespace",
        "unreferenced-hidden-content",
        "hidden-empty-rows"
      ],
      "default": "empty-cells"
    }
  ]
}
